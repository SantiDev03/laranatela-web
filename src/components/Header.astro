---
const rutaActual = Astro.url.pathname;

const enlaces = [
  { href: '/', texto: 'Inicio' },
  { href: '/historia', texto: 'Historia' },
  { href: '/productos', texto: 'Productos' },
  { href: '/servicios', texto: 'Servicios' },
  { href: '/contacto', texto: 'Contacto' },
  { href: '/privacidad', texto: 'Privacidad' },
];
---

<header class="sticky top-0 z-40 border-b border-stone-200 bg-white/95 backdrop-blur">
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-4 py-4"
    aria-label="Navegación principal"
  >
    <a href="/" class="flex items-center" aria-label="La Rañatela, ir al inicio">
      <img
        src="/logo.svg"
        alt="La Rañatela"
        width="150"
        height="138"
        class="h-11 w-auto"
      />
    </a>

    <ul class="hidden items-center gap-6 md:flex">
      {
        enlaces.map((enlace) => (
          <li>
            <a
              href={enlace.href}
              aria-current={rutaActual === enlace.href ? 'page' : undefined}
              class="text-sm font-medium text-stone-600 transition hover:text-marca-600 aria-[current=page]:text-marca-600 aria-[current=page]:underline aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8"
            >
              {enlace.texto}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-3">
      <a
        href="/contacto"
        class="hidden rounded-full bg-marca-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-marca-700 sm:inline-block"
      >
        Pedir presupuesto
      </a>

      <button
        type="button"
        id="boton-menu"
        class="flex h-11 w-11 items-center justify-center rounded-lg border border-stone-300 text-acento-700 transition hover:border-marca-600 hover:text-marca-600 focus:ring-2 focus:ring-marca-600 focus:outline-none md:hidden"
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Abrir menú"
      >
        <svg
          id="icono-abrir"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="3" y1="7" x2="21" y2="7"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="17" x2="21" y2="17"></line>
        </svg>

        <svg
          id="icono-cerrar"
          class="hidden"
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="5" y1="5" x2="19" y2="19"></line>
          <line x1="19" y1="5" x2="5" y2="19"></line>
        </svg>
      </button>
    </div>
  </nav>

  <div id="menu-movil" class="hidden border-t border-stone-200 bg-white md:hidden">
    <ul class="mx-auto max-w-6xl divide-y divide-stone-100 px-4 py-2">
      {
        enlaces.map((enlace) => (
          <li>
            <a
              href={enlace.href}
              aria-current={rutaActual === enlace.href ? 'page' : undefined}
              class="block py-3.5 text-base font-medium text-stone-700 transition aria-[current=page]:text-marca-600 aria-[current=page]:font-semibold"
            >
              {enlace.texto}
            </a>
          </li>
        ))
      }
      <li class="pt-4 pb-3">
        <a
          href="/contacto"
          class="block rounded-full bg-marca-600 px-5 py-3 text-center font-semibold text-white"
        >
          Pedir presupuesto
        </a>
      </li>
    </ul>
  </div>
</header>

<script is:inline>
  (function () {
    var boton = document.getElementById('boton-menu');
    var panel = document.getElementById('menu-movil');
    var abrir = document.getElementById('icono-abrir');
    var cerrar = document.getElementById('icono-cerrar');
    if (!boton || !panel) return;

    function estado(abierto) {
      panel.classList.toggle('hidden', !abierto);
      abrir.classList.toggle('hidden', abierto);
      cerrar.classList.toggle('hidden', !abierto);
      boton.setAttribute('aria-expanded', abierto ? 'true' : 'false');
      boton.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
    }

    boton.addEventListener('click', function () {
      estado(panel.classList.contains('hidden'));
    });

    document.addEventListener('keydown', function (evento) {
      if (evento.key === 'Escape' && !panel.classList.contains('hidden')) {
        estado(false);
        boton.focus();
      }
    });

    // Si se agranda la pantalla, el panel no debe quedar abierto
    window.addEventListener('resize', function () {
      if (window.innerWidth >= 768) estado(false);
    });
  })();
</script>