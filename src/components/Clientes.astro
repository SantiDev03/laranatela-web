---
import { Image } from 'astro:assets';

import cocaColaAndina from '../assets/clientes/coca-cola-andina.png';
import ypf from '../assets/clientes/ypf.png';
import arcor from '../assets/clientes/arcor.png';
import fecovita from '../assets/clientes/fecovita.png';
import pampaEnergia from '../assets/clientes/pampa-energia.png';
import oscarDavid from '../assets/clientes/oscar-david.png';

const clientes = [
  { logo: cocaColaAndina, nombre: 'Coca-Cola Andina', clase: 'h-12 w-40' },
  { logo: ypf, nombre: 'YPF', clase: 'h-12 w-40' },
  { logo: arcor, nombre: 'Arcor', clase: 'h-12 w-40' },
  { logo: oscarDavid, nombre: 'Oscar David Mayorista', clase: 'h-24 w-40' },
  { logo: pampaEnergia, nombre: 'Pampa Energía', clase: 'h-12 w-40' },
  { logo: fecovita, nombre: 'Fecovita', clase: 'h-12 w-40' },
];
---

<section class="border-y border-stone-200 bg-white py-16">
  <div class="mx-auto max-w-6xl px-4">
    <p
      class="text-center text-xs font-semibold tracking-[0.18em] text-marca-600 uppercase"
    >
      Empresas que confían
    </p>

    <h2 class="mt-3 text-center text-3xl sm:text-4xl">
      <span class="registro" data-t="Producimos para grandes marcas">
        <span>Producimos para grandes marcas</span>
      </span>
    </h2>

    <ul
      class="revelar-grupo mt-12 grid grid-cols-2 items-center justify-items-center gap-x-8 gap-y-10 sm:grid-cols-3 lg:grid-cols-6"
    >
      {
        clientes.map((cliente) => (
          <li class="flex h-28 w-full items-center justify-center">
            <Image
              src={cliente.logo}
              alt={`Logo de ${cliente.nombre}`}
              widths={[220, 440]}
              sizes="160px"
              class={`${cliente.clase} object-contain`}
              loading="lazy"
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>