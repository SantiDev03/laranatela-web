---
import '@fontsource-variable/inter';
import '@fontsource-variable/bricolage-grotesque';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Lightbox from '../components/Lightbox.astro';

interface Props {
  titulo: string;
  descripcion: string;
  imagen?: string;
}

const { titulo, descripcion, imagen = '/og.jpg' } = Astro.props;

const tituloCompleto = `${titulo} | La Rañatela`;
const urlCanonica = new URL(Astro.url.pathname, Astro.site);
const urlImagen = new URL(imagen, Astro.site);
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={urlCanonica} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Vista previa al compartir (WhatsApp, Facebook, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="La Rañatela" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:image" content={urlImagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Taller de La Rañatela con bolsas serigrafiadas secando" />

    <!-- X / Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={tituloCompleto} />
    <meta name="twitter:description" content={descripcion} />
    <meta name="twitter:image" content={urlImagen} />

    <meta name="theme-color" content="#d0121f" />
  </head>

  <body
    class="flex min-h-screen flex-col bg-white font-sans text-acento-700 antialiased"
  >
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-acento-700 focus:px-4 focus:py-2 focus:text-white"
    >
      Saltar al contenido principal
    </a>

    <Header />

    <Lightbox />

    <main id="contenido" class="flex-1">
      <slot />
    </main>

    <footer class="mt-24 bg-lienzo">
      <div class="mx-auto max-w-6xl px-4 py-12">
        <hr class="costura" />

        <div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-3">
          <div>
            <p class="font-display text-lg font-extrabold text-acento-700">
              La <span class="text-marca-600">Rañatela</span>
            </p>
            <p class="mt-3 text-sm text-stone-600">
              Inclusión socio-laboral de personas con discapacidad desde 2009.
            </p>
          </div>

          <div class="text-sm text-stone-600">
            <p class="font-semibold text-acento-700">Dónde estamos</p>
            <p class="mt-3">J. B. Martínez 200</p>
            <p>Maipú, Mendoza</p>
            <p class="mt-2">Lunes a viernes de 9 a 16 hs</p>
          </div>

          <div class="text-sm text-stone-600">
            <p class="font-semibold text-acento-700">Contacto</p>
            <p class="mt-3">
              <a
                href="tel:2615341275"
                class="underline decoration-marca-300 underline-offset-4 hover:text-marca-600"
                >261 534 1275</a
              >
            </p>
            <p class="mt-2">
              <a
                href="https://wa.me/5492615341275"
                class="underline decoration-marca-300 underline-offset-4 hover:text-marca-600"
                >Escribinos por WhatsApp</a
              >
            </p>
          </div>
        </div>
      </div>
    </footer>
    <script>
      const objetivos = document.querySelectorAll('.revelar, .revelar-grupo');

      if (
        objetivos.length &&
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ) {
        const observador = new IntersectionObserver(
          (entradas) => {
            entradas.forEach((entrada) => {
              if (entrada.isIntersecting) {
                entrada.target.classList.add('visible');
                observador.unobserve(entrada.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -60px 0px' }
        );

        objetivos.forEach((elemento) => observador.observe(elemento));
      } else {
        objetivos.forEach((elemento) => elemento.classList.add('visible'));
      }
    </script>
  </body>
</html>
