---
import Layout from '../layouts/Layout.astro';

const tecnicas = [
  {
    nombre: 'Serigrafía',
    resumen:
      'Nuestro oficio fundacional. Impresión por color, ideal para tiradas medianas y grandes.',
    detalles: [
      'Excelente rendimiento en cantidades grandes',
      'Colores planos de alta cobertura y muy buena durabilidad',
      'Se imprime un color por vez: el costo varía según la cantidad de colores',
      'Ideal para logos e identidades de marca',
    ],
  },
  {
    nombre: 'Sublimación',
    resumen:
      'Impresión a todo color, sin límite de tonos. La mejor opción para diseños con fotos o degradados.',
    detalles: [
      'Permite imágenes fotográficas, degradados y muchos colores',
      'La tinta se integra a la fibra, sin relieve al tacto',
      'Rinde mejor sobre telas claras con contenido de poliéster',
      'Conviene en tiradas más chicas o diseños complejos',
    ],
  },
  {
    nombre: 'Bordado',
    resumen:
      'La terminación de mayor jerarquía, pensada para indumentaria y uniformes corporativos.',
    detalles: [
      'Máxima durabilidad: resiste lavados industriales',
      'Aporta volumen y percepción de calidad',
      'Ideal para chalecos, camperas, delantales y gorros',
      'Coordinamos el proceso y controlamos la calidad antes de la entrega',
    ],
  },
];

const servicios = [
  {
    nombre: 'Diseño de producto',
    detalle:
      'Si necesitás algo que no está en el catálogo, lo desarrollamos con vos: definimos material, formato y terminaciones según el uso que le vayas a dar.',
  },
  {
    nombre: 'Diseño gráfico',
    detalle:
      'Adaptamos el arte que nos envíes al producto elegido: posición, escala, separación de colores para serigrafía y preparación del archivo para producción. Trabajamos con tu logo en Corel, Illustrator o imagen.',
  },
  {
    nombre: 'Reciclado textil',
    detalle:
      'Recibimos indumentaria corporativa dada de baja y la transformamos en productos nuevos, conservando parte de la prenda original.',
  },
];
---

<Layout
  titulo="Servicios"
  descripcion="Serigrafía, sublimación y bordado. Diseño de producto, diseño gráfico y reciclado textil en Maipú, Mendoza."
>
  <section class="bg-lienzo py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4">
      <p
        class="flex items-center gap-3 text-xs font-semibold tracking-[0.16em] text-marca-600 uppercase"
      >
        Servicios
        <span class="costura hidden w-20 sm:block" aria-hidden="true"></span>
      </p>

      <h1 class="mt-5 text-4xl text-balance sm:text-6xl">
        <span class="registro" data-t="Confección y personalización propia">
          <span>Confección y personalización propia</span>
        </span>
      </h1>

      <p class="mt-7 max-w-2xl text-xl leading-relaxed text-stone-600">
        Confeccionamos y personalizamos en nuestro taller de Maipú, con equipo
        propio. Eso nos permite controlar los tiempos, adaptar lo que haga falta
        y sostener el trabajo de más de 90 personas.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20">
    <h2 class="text-3xl sm:text-4xl">
      <span class="registro" data-t="Técnicas de personalización">
        <span>Técnicas de personalización</span>
      </span>
    </h2>
    <p class="mt-5 max-w-2xl text-stone-600">
      No hay una técnica mejor que otra: depende del diseño, la cantidad y el
      material. Si no estás seguro, contanos qué necesitás y te recomendamos la
      que mejor se ajuste.
    </p>

    <ul class="revelar-grupo mt-10 grid grid-cols-1 gap-6 lg:grid-cols-3">
      {
        tecnicas.map((tecnica) => (
          <li class="flex flex-col rounded-xl border border-stone-200 p-6 transition hover:border-marca-600 hover:shadow-md">
            <h3 class="font-display text-xl font-bold text-marca-600">
              {tecnica.nombre}
            </h3>
            <p class="mt-3 text-stone-600">{tecnica.resumen}</p>
            <ul class="mt-5 space-y-2 border-t border-stone-200 pt-5 text-sm text-stone-700">
              {tecnica.detalles.map((detalle) => (
                <li class="flex gap-2">
                  <span aria-hidden="true" class="font-bold text-marca-600">
                    ·
                  </span>
                  <span>{detalle}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="border-y border-stone-200 bg-lienzo py-16">
    <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-10 px-4 lg:grid-cols-2">
      <video
        id="video-taller"
        autoplay
        muted
        loop
        playsinline
        controls
        preload="metadata"
        poster="/images/taller-servicios-poster.jpg"
        class="revelar aspect-[4/5] w-full rounded-xl border border-stone-200 object-cover"
      >
        <source src="/videos/taller-servicios.mp4" type="video/mp4" />
      </video>

      <div class="revelar">
        <h2 class="text-3xl sm:text-4xl">
          <span class="registro" data-t="Todo pasa por acá">
            <span>Todo pasa por acá</span>
          </span>
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-stone-700">
          Desde el corte y la confección hasta la impresión y el control final,
          la producción ocurre en nuestro taller. No somos intermediarios: cada
          etapa la hace nuestro equipo, y eso es lo que nos permite responder
          por los plazos y por la calidad.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-20">
    <h2 class="text-3xl sm:text-4xl">
      <span class="registro" data-t="Servicios complementarios">
        <span>Servicios complementarios</span>
      </span>
    </h2>

    <ul class="revelar-grupo mt-10 grid grid-cols-1 gap-6 lg:grid-cols-3">
      {
        servicios.map((servicio) => (
          <li class="rounded-xl border border-stone-200 bg-white p-6">
            <h3 class="text-lg font-bold text-acento-700">{servicio.nombre}</h3>
            <p class="mt-3 text-stone-700">{servicio.detalle}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="bg-acento-700 py-16 text-white">
    <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-10 px-4 lg:grid-cols-2">
      <div>
        <h2 class="font-display text-3xl font-extrabold sm:text-4xl">
          ¿Tu empresa está renovando uniformes?
        </h2>
        <p class="mt-4 text-stone-300">
          Recibimos indumentaria corporativa dada de baja y la transformamos en
          productos nuevos: delantales, bolsos y accesorios que conservan parte
          de la prenda original. Menos residuo textil, más trabajo inclusivo.
        </p>
        <a
          href="/contacto"
          class="mt-8 inline-block rounded-full bg-marca-600 px-6 py-3 font-semibold text-white transition hover:-translate-y-0.5 hover:bg-marca-700"
        >
          Consultar por reciclado textil
        </a>
      </div>

      <video
        controls
        playsinline
        preload="metadata"
        poster="/images/reciclaje-servicios-poster.jpg"
        class="aspect-[4/5] w-full rounded-xl object-cover"
      >
        <source src="/videos/reciclaje-servicios.mp4" type="video/mp4" />
      </video>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-20 text-center">
    <h2 class="text-3xl sm:text-4xl">
      <span class="registro" data-t="¿No sabés qué técnica te conviene?">
        <span>¿No sabés qué técnica te conviene?</span>
      </span>
    </h2>
    <p class="mt-6 text-lg text-stone-600">
      Contanos qué producto tenés en mente, la cantidad y cómo es tu logo. Te
      recomendamos la mejor opción y te enviamos el presupuesto sin cargo.
    </p>
    <a
      href="/contacto"
      class="mt-8 inline-block rounded-full bg-marca-600 px-6 py-3 font-semibold text-white transition hover:-translate-y-0.5 hover:bg-marca-700"
    >
      Pedir asesoramiento
    </a>
  </section>
</Layout>

<script>
  // Si el sistema del usuario tiene activado "reducir movimiento",
  // no arrancamos el video de fondo solo — que lo inicie a mano con los controles.
  const videoTaller = document.getElementById('video-taller') as HTMLVideoElement | null;
  if (videoTaller && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    videoTaller.removeAttribute('autoplay');
    videoTaller.pause();
  }
</script>