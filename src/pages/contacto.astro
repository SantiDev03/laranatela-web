---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
const productos = await getCollection('productos');
productos.sort((a, b) => a.data.nombre.localeCompare(b.data.nombre));
const pasos = [
  {
    titulo: 'Nos contás qué necesitás',
    detalle:
      'Producto, cantidad aproximada, medidas si las tenés y para cuándo lo necesitás.',
  },
  {
    titulo: 'Te enviamos el presupuesto',
    detalle:
      'Sin cargo y sin compromiso. Si hace falta, te proponemos alternativas de material o formato.',
  },
  {
    titulo: 'Aprobás el arte',
    detalle:
      'Preparamos el diseño con tu logo y te lo mandamos para que lo revises antes de producir.',
  },
  {
    titulo: 'Producimos',
    detalle:
      'El plazo estimado es de 10 a 15 días hábiles desde que aprobás el arte.',
  },
  {
    titulo: 'Entregamos',
    detalle:
      'Coordinamos retiro en nuestro taller de Maipú o envío según lo que te resulte más cómodo.',
  },
];
---
<Layout
  titulo="Contacto"
  descripcion="Pedí tu presupuesto sin cargo. Fabricamos bolsas, mochilas, neceseres e indumentaria a medida en Maipú, Mendoza."
>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <p
      class="flex items-center gap-3 text-xs font-semibold tracking-[0.16em] text-marca-600 uppercase"
    >
      Contacto
      <span class="costura hidden w-20 sm:block" aria-hidden="true"></span>
    </p>
    <h1 class="mt-5 text-4xl text-balance sm:text-6xl">
      <span class="registro" data-t="Pedinos tu presupuesto">
        <span>Pedinos tu presupuesto</span>
      </span>
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-stone-600">
      Contanos qué necesitás y te respondemos con un presupuesto sin cargo.
      Cuanta más información nos des, más precisa va a ser la cotización.
    </p>
    <div class="mt-12 grid grid-cols-1 gap-12 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <div
          id="error-envio"
          class="hidden mb-6 rounded-lg border border-red-300 bg-red-50 px-4 py-3 text-sm text-red-700"
          role="alert"
        >
          Hubo un problema al enviar tu consulta. Probá de nuevo en un momento,
          o escribinos directo por
          <a
            href="https://wa.me/5492615341275?text=%C2%A1Hola%21%20Intent%C3%A9%20enviar%20una%20consulta%20desde%20la%20web%20pero%20tuve%20un%20problema.%20Quer%C3%ADa%20consultar%20por%20un%20presupuesto."
            class="font-medium underline"
          >WhatsApp</a>.
        </div>

        <form
          method="POST"
          action="https://laranatela-consulta.laranatela.workers.dev"
          class="space-y-8"
          aria-labelledby="titulo-formulario"
        >
          <h2 id="titulo-formulario" class="sr-only">
            Formulario de solicitud de presupuesto
          </h2>
          <div class="hidden" aria-hidden="true">
            <label for="sitio-web">No completar este campo</label>
            <input type="text" id="sitio-web" name="sitio-web" tabindex="-1" autocomplete="off" />
          </div>
          <fieldset class="space-y-6">
            <legend class="text-lg font-semibold text-acento-700">
              Tus datos
            </legend>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div>
                <label for="nombre" class="block text-sm font-medium text-stone-700">
                  Nombre y apellido <span class="text-acento-700">*</span>
                </label>
                <input
                  type="text"
                  id="nombre"
                  name="nombre"
                  required
                  autocomplete="name"
                  class="mt-2 block w-full rounded-lg border border-stone-300 px-4 py-2.5 text-acento-700 focus:border-marca-600 focus:ring-2 focus:ring-marca-600 focus:outline-none"
                />
              </div>
              <div>
                <label for="empresa" class="block text-sm font-medium text-stone-700">
                  Empresa u organización
                </label>
                <input
                  type="text"
                  id="empresa"
                  name="empresa"
                  autocomplete="organization"
                  class="mt-2 block w-full rounded-lg border border-stone-300 px-4 py-2.5 text-acento-700 focus:border-marca-600 focus:ring-2 focus:ring-marca-600 focus:outline-none"
                />
              </div>
              <div>
                <label for="email" class="block text-sm font-medium text-stone-700">
                  Correo electrónico <span class="text-acento-700">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  autocomplete="email"
                  class="mt-2 block w-full rounded-lg border border-stone-300 px-4 py-2.5 text-acento-700 focus:border-marca-600 focus:ring-2 focus:ring-marca-600 focus:outline-none"
                />
              </div>
              <div>
                <label for="telefono" class="block text-sm font-medium text-stone-700">
                  Teléfono o WhatsApp
                </label>
                <input
                  type="tel"
                  id="telefono"
                  name="telefono"
                  autocomplete="tel"
                  class="mt-2 block w-full rounded-lg border border-stone-300 px-4 py-2.5 text-acento-700 focus:border-marca-600 focus:ring-2 focus:ring-marca-600 focus:outline-none"
                />
              </div>
            </div>
          </fieldset>
          <fieldset class="space-y-6">
            <legend class="text-lg font-semibold text-acento-700">
              Qué necesitás
            </legend>
            <div>
              <label for="producto" class="block text-sm font-medium text-stone-700">
                Producto de interés
              </label>
              <select
                id="producto"
                name="producto"
                class="mt-2 block w-full rounded-lg border border-stone-300 px-4 py-2.5 text-acento-700 focus:border-marca-600 focus:ring-2 focus:ring-marca-600 focus:outline-none"
              >
                <option value="">Todavía no lo tengo definido</option>
                {
                  productos.map((producto) => (
                    <option value={producto.data.nombre}>
                      {producto.data.nombre}
                    </option>
                  ))
                }
                <option value="Otro">Otro / desarrollo a medida</option>
              </select>
            </div>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
              <div>
                <label for="cantidad" class="block text-sm font-medium text-stone-700">
                  Cantidad aproximada
                </label>
                <input
                  type="text"
                  id="cantidad"
                  name="cantidad"
                  placeholder="Minimo 100 unidades"
                  class="mt-2 block w-full rounded-lg border border-stone-300 px-4 py-2.5 text-acento-700 focus:border-marca-600 focus:ring-2 focus:ring-marca-600 focus:outline-none"
                />
              </div>
              <div>
                <label for="medidas" class="block text-sm font-medium text-stone-700">
                  Medidas
                </label>
                <input
                  type="text"
                  id="medidas"
                  name="medidas"
                  placeholder="Alto x ancho x fuelle, si ya las tenés"
                  class="mt-2 block w-full rounded-lg border border-stone-300 px-4 py-2.5 text-acento-700 focus:border-marca-600 focus:ring-2 focus:ring-marca-600 focus:outline-none"
                />
              </div>
              <div>
                <label for="fecha" class="block text-sm font-medium text-stone-700">
                  ¿Para cuándo lo necesitás?
                </label>
                <input
                  type="date"
                  id="fecha"
                  name="fecha"
                  class="mt-2 block w-full rounded-lg border border-stone-300 px-4 py-2.5 text-acento-700 focus:border-marca-600 focus:ring-2 focus:ring-marca-600 focus:outline-none"
                />
                <p class="mt-2 text-sm text-stone-500">
                  Tené en cuenta que el plazo habitual es de 10 a 15 días hábiles.
                </p>
              </div>
              <div>
                <label for="logo" class="block text-sm font-medium text-stone-700">
                  ¿En qué formato tenés el logo?
                </label>
                <select
                  id="logo"
                  name="logo"
                  class="mt-2 block w-full rounded-lg border border-stone-300 px-4 py-2.5 text-acento-700 focus:border-marca-600 focus:ring-2 focus:ring-marca-600 focus:outline-none"
                >
                  <option value="">Seleccioná una opción</option>
                  <option value="Corel (.cdr)">Corel Draw (.cdr)</option>
                  <option value="Illustrator (.ai)">Adobe Illustrator (.ai)</option>
                  <option value="Imagen (.png / .jpg)">Imagen (.png o .jpg)</option>
                  <option value="Lo tengo que pedir">Lo tengo que pedir al área de marketing</option>
                  <option value="Sin impresion">No lleva impresión</option>
                </select>
              </div>
            </div>
            <div>
              <label for="mensaje" class="block text-sm font-medium text-stone-700">
                Contanos más <span class="text-acento-700">*</span>
              </label>
              <textarea
                id="mensaje"
                name="mensaje"
                rows="5"
                required
                placeholder="Colores, técnica de impresión, si es para un evento puntual, o cualquier detalle que nos ayude a cotizar mejor."
                class="mt-2 block w-full rounded-lg border border-stone-300 px-4 py-2.5 text-acento-700 focus:border-marca-600 focus:ring-2 focus:ring-marca-600 focus:outline-none"
              ></textarea>
            </div>
          </fieldset>
          <div>
            <button
              type="submit"
              class="w-full rounded-full bg-marca-600 px-6 py-3.5 text-base font-semibold text-white transition hover:bg-marca-700 focus:ring-2 focus:ring-marca-600 focus:ring-offset-2 focus:outline-none sm:w-auto"
            >
              Enviar consulta
            </button>
            <p class="mt-3 text-sm text-stone-500">
              Los campos marcados con <span class="text-acento-700">*</span> son
              obligatorios. Usamos tus datos únicamente para responder esta
              consulta.
            </p>
          </div>
        </form>
      </div>
      <aside class="space-y-8">
        <div class="rounded-xl border border-stone-200 bg-lienzo p-6">
          <h2 class="text-lg font-semibold text-acento-700">
            Escribinos directo
          </h2>
          <ul class="mt-4 space-y-4 text-stone-700">
            <li>
              <p class="text-sm font-medium text-stone-500">WhatsApp</p>
              <a
                href="https://wa.me/5492615341275?text=%C2%A1Hola%21%20Vi%20la%20p%C3%A1gina%20de%20La%20Ra%C3%B1atela%20y%20quer%C3%ADa%20consultar%20por%20un%20presupuesto."
                class="mt-1 inline-block font-medium text-marca-600 underline hover:text-acento-700"
              >
                261 534 1275
              </a>
            </li>
            <li>
              <p class="text-sm font-medium text-stone-500">Dirección</p>
              <p class="mt-1">J. B. Martínez 200, Maipú, Mendoza</p>
            </li>
            <li>
              <p class="text-sm font-medium text-stone-500">Horario de atención</p>
              <p class="mt-1">Lunes a viernes de 9 a 16 hs.</p>
            </li>
          </ul>
        </div>
        <div class="rounded-xl border border-marca-200 bg-marca-50 p-6">
          <h2 class="text-lg font-semibold text-acento-700">
            Comprar acá tiene otro sentido
          </h2>
          <p class="mt-3 text-stone-700">
            Cada pedido que producimos sostiene el trabajo de más de 90 personas
            con discapacidad. No es un dato de marketing: es la razón por la que
            existe La Rañatela.
          </p>
        </div>
      </aside>
    </div>
    <div class="mt-20">
      <h2 class="text-3xl sm:text-4xl">
        <span class="registro" data-t="Cómo trabajamos"><span>Cómo trabajamos</span></span>
      </h2>
      <ol class="revelar-grupo mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-5">
        {
          pasos.map((paso, indice) => (
            <li class="rounded-xl border-t-2 border-marca-600 bg-white p-6 shadow-sm">
              <p class="font-display text-3xl font-extrabold text-marca-600">{indice + 1}</p>
              <h3 class="mt-2 font-semibold text-acento-700">{paso.titulo}</h3>
              <p class="mt-2 text-sm text-stone-600">{paso.detalle}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Layout>

<script>
  if (new URLSearchParams(window.location.search).get('error') === '1') {
    document.getElementById('error-envio')?.classList.remove('hidden');
  }
</script>