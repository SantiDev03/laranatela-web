---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const productos = await getCollection('productos');
productos.sort((a, b) => a.data.orden - b.data.orden);

const categorias = [
  { id: 'ecobolsas', nombre: 'Ecobolsas' },
  { id: 'mochilas-bolsos', nombre: 'Mochilas y Bolsos' },
  { id: 'combos', nombre: 'Combos' },
  { id: 'merchandising', nombre: 'Merchandising' },
];
---

<Layout
  titulo="Productos"
  descripcion="Eco bolsas reutilizables, mochilas, bolsos, combos y merchandising fabricados a pedido en Maipú, Mendoza."
>
  <section class="mx-auto max-w-6xl px-4 py-16">
    <p class="text-sm font-semibold tracking-wide text-acento-700 uppercase">
      Catálogo
    </p>
    <h1 class="mt-3 text-4xl font-bold text-marca-800 sm:text-5xl">
      Nuestros productos
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-slate-600">
      Todos nuestros productos se fabrican a pedido y se adaptan a los
      requerimientos de cada cliente. El plazo de entrega estimado es de 10 a 15
      días hábiles.
    </p>

    {
      categorias.map((categoria) => {
        const deCategoria = productos.filter(
          (producto) => producto.data.categoria === categoria.id
        );

        if (deCategoria.length === 0) return null;

        return (
          <div class="mt-16">
            <h2 class="text-2xl font-bold text-marca-800">{categoria.nombre}</h2>

            <ul class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {deCategoria.map((producto) => (
                <li class="rounded-xl border border-slate-200 p-6 transition hover:border-marca-400 hover:shadow-md">
                  <h3 class="text-lg font-semibold text-slate-900">
                    {producto.data.nombre}
                  </h3>
                  <p class="mt-2 text-sm text-slate-600">
                    {producto.data.resumen}
                  </p>

                  <dl class="mt-4 space-y-1 text-sm text-slate-500">
                    {producto.data.medidas && (
                      <div class="flex gap-2">
                        <dt class="font-medium">Medidas:</dt>
                        <dd>{producto.data.medidas}</dd>
                      </div>
                    )}
                    {producto.data.material && (
                      <div class="flex gap-2">
                        <dt class="font-medium">Material:</dt>
                        <dd>{producto.data.material}</dd>
                      </div>
                    )}
                    {producto.data.minimo && (
                      <div class="flex gap-2">
                        <dt class="font-medium">Mínimo:</dt>
                        <dd>{producto.data.minimo} unidades</dd>
                      </div>
                    )}
                  </dl>

                  {producto.data.impresion.length > 0 && (
                    <ul class="mt-4 flex flex-wrap gap-2">
                      {producto.data.impresion.map((tecnica) => (
                        <li class="rounded-full bg-marca-100 px-3 py-1 text-xs font-medium text-marca-800">
                          {tecnica}
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </div>
        );
      })
    }
  </section>
</Layout>