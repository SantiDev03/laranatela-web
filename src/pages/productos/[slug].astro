---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import SchemaProduct from '../../components/SchemaProduct.astro';

export async function getStaticPaths() {
  const productos = await getCollection('productos');

  return productos.map((producto) => ({
    params: { slug: producto.id },
    props: { producto },
  }));
}

type Props = {
  producto: CollectionEntry<'productos'>;
};

const { producto } = Astro.props;
const { Content } = await render(producto);

const nombresCategoria: Record<string, string> = {
  bolsas: 'Bolsas y ecobolsas',
  'mochilas-bolsos': 'Mochilas y bolsos',
  neceseres: 'Neceseres y cartucheras',
  'linea-vinos': 'Línea vinos',
  termicos: 'Línea térmica',
  indumentaria: 'Indumentaria y uniformes',
  combos: 'Combos y sets',
  merchandising: 'Merchandising',
};

const nombresMaterial: Record<string, string> = {
  lienzo: 'Lienzo',
  friselina: 'Friselina',
  gabardina: 'Gabardina',
  brin: 'Brin',
  jean: 'Jean',
  neoprene: 'Neoprene',
  poliester: 'Poliéster',
  polar: 'Polar',
  ceramica: 'Cerámica',
  algodon: 'Algodón',
  mixto: 'Materiales combinados',
};

const nombresFuelle: Record<string, string> = {
  'sin-fuelle': 'Sin fuelle',
  base: 'Fuelle en base',
  contorno: 'Fuelle en contorno',
};

// Texto de opciones de material para la ficha técnica.
// - materialFijo: true -> no se muestra nada (no hay alternativa).
// - materialesAlternativos con datos -> lista puntual para este producto.
// - si no, el texto general (regla por defecto para la mayoría del catálogo).
const textoOpcionesMaterial = producto.data.materialesAlternativos.length > 0
  ? `También en ${producto.data.materialesAlternativos.join(', ')}.`
  : 'También podemos confeccionarlo en friselina, gabardina o lienzo. Consultanos si necesitás otra tela.';

// --- Datos para el schema Product ---

const urlCanonica = new URL(Astro.url.pathname, Astro.site);

const rutasImagenes = [
  producto.data.imagen?.src,
  ...producto.data.galeria.map((foto) => foto.src.src),
].filter((ruta): ruta is string => Boolean(ruta));

const imagenesProducto = rutasImagenes.map((ruta) => new URL(ruta, Astro.site).href);

const propiedadesProducto = [
  producto.data.fuelle && {
    nombre: 'Fuelle',
    valor: nombresFuelle[producto.data.fuelle],
  },
  {
    nombre: 'Medidas',
    valor: producto.data.medidaReferencia ?? 'A medida del cliente',
  },
  producto.data.colores.length > 0 && {
    nombre: 'Colores',
    valor: producto.data.colores.join(', '),
  },
  producto.data.impresion.length > 0 && {
    nombre: 'Personalización',
    valor: producto.data.impresion.join(', '),
  },
  !producto.data.materialFijo && {
    nombre: 'Otras opciones de tela',
    valor: textoOpcionesMaterial,
  },
].filter((propiedad): propiedad is { nombre: string; valor: string } => Boolean(propiedad));
---

<Layout titulo={producto.data.nombre} descripcion={producto.data.resumen}>
  <SchemaProduct
    nombre={producto.data.nombre}
    descripcion={producto.data.resumen}
    imagenes={imagenesProducto}
    categoria={nombresCategoria[producto.data.categoria]}
    material={nombresMaterial[producto.data.material]}
    url={urlCanonica.href}
    propiedades={propiedadesProducto}
  />

  <article class="mx-auto max-w-3xl px-4 py-12">
    <nav aria-label="Migas de pan" class="text-sm text-slate-500">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="hover:text-marca-700 hover:underline">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/productos" class="hover:text-marca-700 hover:underline">Productos</a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="text-slate-700">{producto.data.nombre}</li>
      </ol>
    </nav>

    <p class="mt-8 text-sm font-semibold tracking-wide text-acento-700 uppercase">
      {nombresCategoria[producto.data.categoria]}
    </p>

    <h1 class="mt-3 text-4xl text-balance sm:text-5xl">
      <span class="registro" data-t={producto.data.nombre}>
        <span>{producto.data.nombre}</span>
      </span>
    </h1>

    {
      producto.data.reciclado && (
        <p class="mt-4 inline-flex rounded-full bg-acento-600 px-4 py-1.5 text-sm font-semibold text-white">
          Confeccionado con material recuperado
        </p>
      )
    }

    <p class="mt-4 text-lg text-slate-600">{producto.data.resumen}</p>

    <div data-galeria>
      {
        producto.data.imagen && (
          <Image
            src={producto.data.imagen}
            alt={producto.data.imagenAlt ?? producto.data.nombre}
            widths={[400, 800, 1600]}
            sizes="(max-width: 768px) 100vw, 768px"
            class="mt-8 w-full rounded-xl border border-stone-200 transition hover:border-marca-400"
            loading="eager"
            data-ampliable="true"
          />
        )
      }

      {
        producto.data.galeria.length > 0 && (
          <ul class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3">
            {producto.data.galeria.map((foto) => (
              <li>
                <Image
                  src={foto.src}
                  alt={foto.alt}
                  widths={[240, 480, 1200]}
                  sizes="(max-width: 640px) 50vw, 240px"
                  class="aspect-square w-full rounded-lg border border-stone-200 object-cover transition hover:border-marca-400"
                  loading="lazy"
                  data-ampliable="true"
                />
              </li>
            ))}
          </ul>
        )
      }

      <p class="mt-3 text-sm text-stone-500">
        Hacé clic en cualquier foto para verla más grande.
      </p>
    </div>

    <div class="revelar mt-10 rounded-xl border border-stone-200 bg-lienzo p-6">
      <h2 class="text-lg font-semibold text-slate-900">Ficha técnica</h2>

      <dl class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-medium text-slate-500">Material</dt>
          <dd class="mt-1 text-slate-800">
            {nombresMaterial[producto.data.material]}
          </dd>
        </div>

        {
          producto.data.fuelle && (
            <div>
              <dt class="text-sm font-medium text-slate-500">Fuelle</dt>
              <dd class="mt-1 text-slate-800">
                {nombresFuelle[producto.data.fuelle]}
              </dd>
            </div>
          )
        }

        <div>
          <dt class="text-sm font-medium text-slate-500">Medidas</dt>
          <dd class="mt-1 text-slate-800">
            {producto.data.medidaReferencia ?? 'A medida del cliente'}
          </dd>
        </div>

        {
          producto.data.colores.length > 0 && (
            <div>
              <dt class="text-sm font-medium text-slate-500">Colores</dt>
              <dd class="mt-1 text-slate-800">
                {producto.data.colores.join(', ')}
              </dd>
            </div>
          )
        }

        {
          producto.data.impresion.length > 0 && (
            <div>
              <dt class="text-sm font-medium text-slate-500">Personalización</dt>
              <dd class="mt-1 text-slate-800">
                {producto.data.impresion.join(', ')}
              </dd>
            </div>
          )
        }

        {
          !producto.data.materialFijo && (
            <div>
              <dt class="text-sm font-medium text-slate-500">Otras opciones de tela</dt>
              <dd class="mt-1 text-slate-800">{textoOpcionesMaterial}</dd>
            </div>
          )
        }

        <div>
          <dt class="text-sm font-medium text-slate-500">Plazo de entrega</dt>
          <dd class="mt-1 text-slate-800">10 a 15 días hábiles</dd>
        </div>
      </dl>
    </div>

    <div class="mt-10 space-y-4 text-lg leading-relaxed text-slate-700">
      <Content />
    </div>

    <div class="revelar mt-12 rounded-xl bg-marca-600 p-8 text-white">
      <h2 class="text-2xl font-bold">¿Te interesa este producto?</h2>
      <p class="mt-2 text-marca-100">
        Contanos las medidas, la cantidad y qué querés imprimir, y te enviamos
        un presupuesto sin cargo.
      </p>
      <a
        href="/contacto"
        class="mt-6 inline-block rounded-lg bg-white px-6 py-3 font-semibold text-marca-800 transition hover:bg-marca-50"
      >
        Pedir cotización
      </a>
    </div>

    <p class="mt-10">
      <a href="/productos" class="text-marca-700 underline hover:text-marca-800">
        Volver al catálogo
      </a>
    </p>
  </article>
</Layout>